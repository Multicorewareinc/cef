+#if defined(_M_ARM64EC)
+// On ARM64EC, JIT memory is treated as x64 code unless it is marked as EC code
+// with MEM_EXTENDED_PARAMETER_EC_CODE. V8 reserves its JIT regions as
+// inaccessible (kNoAccessWillJitLater maps to kInaccessible, and
+// TrimMappingInternal drops the page tag), and code pages are decommitted and
+// recommitted as the GC frees and reuses them, so mark every reservation and
+// every commit as EC code. The mark only affects pages that are executable.
+void* VirtualAllocMaybeECCode(void* address,
+                              size_t length,
+                              DWORD type_flags,
+                              DWORD access_flag) {
+  using VirtualAlloc2Function = PVOID(WINAPI*)(
+      HANDLE, PVOID, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER*, ULONG);
+  static VirtualAlloc2Function virtual_alloc2 =
+      reinterpret_cast<VirtualAlloc2Function>(GetProcAddress(
+          GetModuleHandle(L"kernelbase.dll"), "VirtualAlloc2"));
