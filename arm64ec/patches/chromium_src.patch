+// found in the LICENSE file.
+
+// The static MSVC C++ runtime (libcpmt.lib) references the AddressSanitizer
+// container annotation hook and relies on an /alternatename directive to fall
+// back to a no-op default when ASan is not linked. lld does not apply that
+// directive to ARM64EC symbols, so ARM64EC links that use the static runtime
+// fail with an undefined __sanitizer_annotate_contiguous_container. Provide the
+// same no-op here. This file is only built for non-ASan ARM64EC targets.
+
+extern "C" void __sanitizer_annotate_contiguous_container(const void* beg,
+                                                          const void* end,
+                                                          const void* old_mid,
+                                                          const void* new_mid) {
+}
